+/* ---- G9: the exact content-only emptiness predicate ---- */
+function m10cLocalEmpty(p){
+  var zk=function(o){return !o||Object.keys(o).length===0;};
+  var g=p.glp||{};
+  return (p.weights||[]).length===0&&zk(p.food)&&zk(p.workouts)&&zk(p.steps)&&
