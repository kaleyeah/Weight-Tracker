+      var back;try{back=localStorage.getItem("wl_v1");}catch(ex){back=null;}
+      if(back!==JSON.stringify(obj)){m10cBlock("could not verify the adopted copy");cb&&cb(false);return;}
+      if(!m10cJournalAdvance(j,"k1")){m10cBlock("could not verify the adoption phase");cb&&cb(false);return;}}
+    if(j.phase==="k1"){
+      if(!m10cWrite("base",{canon:M10C_CANON_VER,rev:e.serverRev,body:e.serverCanon})){m10cBlock("could not record the acknowledged copy");cb&&cb(false);return;}
