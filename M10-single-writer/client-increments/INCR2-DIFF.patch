+    if(!(b.st==="ok"&&b.val.rev===e.serverRev&&b.val.body===e.serverCanon)){m10cBlock("could not verify the acknowledged copy");cb&&cb(false);return;}
+    m10cRemove("journal");
+    if(m10cRead("journal").st!=="absent"){m10cBlock("could not clear a finished sync record");cb&&cb(false);return;}
+    cb&&cb(true);return;}
