+  if(v.op==="core-bootstrap"||v.op==="core-adopt"){m10cFinishBootAdopt(v,cb);return;}
+  cb&&cb(false);}
+
+/* ---- G9/G10 bootstrap ---- */
+function m10cBootstrap(cb){
+  var uid=m8Uid();if(!uid){cb&&cb(false);return;}
+  pbGetRecord(function(rec,err){
+    if(err){cb&&cb(false);return;}
+    var lp=payload();
+    var lc=m10cCanon(lp);
+    if(!lc.ok){m10cBlock("core data failed validation ("+lc.error+")");cb&&cb(false);return;}
