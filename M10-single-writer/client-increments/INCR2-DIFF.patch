+  if(j.st!=="ok"){cb&&cb(true);return;}
+  var v=j.val;
+  var err=m10cValidateJournal(v);
+  if(err){if(m10cQuarantine("journal"))m10cBlock("an invalid core sync record was preserved and needs review");cb&&cb(false);return;}
+  if(v.op==="core-ack"){
+    if(v.phase==="done"&&v.outcome){cb&&cb(false);return;}     /* review-pending: increment 3 */
+    if(v.phase==="net-done"||v.phase==="k1"||v.phase==="k2"){m10cComplete(v,cb);return;}
+    var pobj;try{pobj=JSON.parse(v.expect.pushedCanon);}catch(ex){pobj=null;}
+    if(!pobj){if(m10cQuarantine("journal"))m10cBlock("an unreadable core sync record was preserved");cb&&cb(false);return;}
