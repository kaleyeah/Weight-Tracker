+/* Completion of a landed commit from journal j (phases net-done→k1→k2→done).
+   Every advance is a verified write; failures block, never lose. */
+function m10cComplete(j,cb){
+  var e=j.expect;
+  if(j.phase==="net-done"){
+    if(!m10cWrite("base",{canon:M10C_CANON_VER,rev:e.newRev,body:e.pushedCanon})){m10cBlock("could not record the acknowledged copy");cb&&cb(false);return;}
+    var b=m10cRead("base");
+    if(!(b.st==="ok"&&b.val.rev===e.newRev&&b.val.body===e.pushedCanon)){m10cBlock("could not verify the acknowledged copy");cb&&cb(false);return;}
+    if(!m10cJournalAdvance(j,"k1")){m10cBlock("could not verify the base phase");cb&&cb(false);return;}}
