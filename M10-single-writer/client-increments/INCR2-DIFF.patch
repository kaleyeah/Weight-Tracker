+      var ja={op:"core-adopt",phase:"intent",startedAt:Date.now(),expect:{serverRev:serverRev,serverCanon:sc.canon}};
+      if(!m10cJournalWrite(ja)){cb&&cb(false);return;}
+      m10cFinishBootAdopt(ja,cb);return;}
